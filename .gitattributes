# Normalise line endings in the repository: text files are stored with LF, so a
# Windows checkout and a Linux one produce identical blobs and no pull request
# turns into a wall of line-ending changes.
* text=auto

# Shell scripts (git hooks, CI helpers) must stay LF on every platform, so `sh`
# never chokes on a CRLF shebang.
.githooks/* text eol=lf
*.sh text eol=lf

# Container and CI inputs are parsed by Linux tools: keep them LF even on a
# Windows checkout. A CRLF Dockerfile can leave a stray \r in RUN commands.
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.github/workflows/*.yml text eol=lf

# Binary assets: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.webm binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.exe binary
*.msi binary
*.dll binary

# Generated files: keep them out of language statistics and collapse them in
# diffs on GitHub.
package-lock.json linguist-generated
