# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results*
/playwright-report
/blob-report
.playwright/

# parity-loop artifacts (evidence logs stay local-only)
scripts/_logs/
scripts/_gate_*.ps1
scripts/_b*-check.mjs
scripts/_scratch_*.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# the desktop boot wrapper's per-install session secret (scripts/desktop/boot-wrapper.cjs).
# It normally lives in the app's data directory; this covers running the wrapper
# from a checkout, where it would otherwise be one `git add` away from a commit.
auth-secret

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local uploads (user content)
/uploads
# session registry (B54 — file-backed device list / revocation)
/.data/
# generated audit data
docs/_audit-raw.json
/backups/

# Local verification artefacts (screenshots captured by scripts/_capture.cjs)
docs/screenshots/
scripts/_capture.cjs

# Scratch/debug files an agent or a human leaves behind: never commit these.
scripts/_*
