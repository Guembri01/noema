# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results*
/playwright-report
/blob-report
.playwright/

# parity-loop artifacts (evidence logs stay local-only)
scripts/_logs/
scripts/_gate_*.ps1
scripts/_b*-check.mjs
scripts/_scratch_*.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# the desktop boot wrapper's per-install session secret (scripts/desktop/boot-wrapper.cjs).
# It normally lives in the app's data directory; this covers running the wrapper
# from a checkout, where it would otherwise be one `git add` away from a commit.
auth-secret

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local uploads (user content)
/uploads
# session registry (B54 — file-backed device list / revocation)
/.data/
# generated audit data
docs/_audit-raw.json
/backups/

# The screenshot gallery *is* tracked: `npm run screenshots` regenerates it from
# the seeded demo workspace, so it is reproducible output rather than local
# scratch, and it is what the README and docs/GALLERY.md link to. One-off captures
# still do not belong here — write those anywhere else.
#
# The *subdirectories* are the opposite: they are per-run output from the browser
# checks (`check:floating`, `check:layering`, `check:popovers`, `check:motion`,
# the a11y/visual audits), regenerated every time one of them runs. Ignoring the
# directories rather than the whole tree is what keeps the two apart.
docs/screenshots/*/
scripts/_capture.cjs

# Scratch/debug files an agent or a human leaves behind: never commit these.
scripts/_*

# The product film (video/) is its own Remotion project: the app's tsconfig and
# ESLint exclude it, and it has its own package.json. Its dependencies, the
# generated 2x page textures it captures, the third-party audio it borrows and the
# rendered MP4 are all reproducible or external — the film *source* is tracked, the
# artefacts are not.
/video/node_modules/
/video/out/
/video/public/textures/
/video/public/cutouts/
/video/public/audio/
/video/.remotion/
