# Noema — local development environment
# Copy to `.env` and adjust. `.env` is git-ignored.

# Password of the `noema` database role. The compose stack starts the database
# with it and REFUSES to start without it, so the value is required — and it
# ships empty on purpose: a database that listens on a published port with a
# publicly known password is a full data leak.
# Use URL-safe characters only (the password is part of the connection string
# below). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
POSTGRES_PASSWORD=

# PostgreSQL connection used by Prisma. The password is the one set above:
# replace <POSTGRES_PASSWORD> with it, so that both hold the same value.
DATABASE_URL="postgresql://noema:<POSTGRES_PASSWORD>@localhost:5433/noema?schema=public"

# Secret used to sign session cookies (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The placeholder below is REFUSED by the app: it is public, so every instance
# that keeps it shares the same signing key. Replace it before the first start.
AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"

# Optional: sign-in strategy switches (registry: src/lib/auth-strategies.ts).
# AUTH_PASSWORD — the local email + password sign-in and sign-up. Set it to a
#   falsy value ("disabled", "off", "no", "0", "false") to turn the strategy
#   off, e.g. for a single-sign-on-only deployment. Unset = the password
#   strategy is on.
# AUTH_PASSWORD="disabled"
# AUTH_STRATEGIES — comma-separated allow-list of the strategies that may be
#   used, e.g. "password,google,saml". When set, every strategy outside the
#   list is off — including the password sign-in. Unset/blank = no allow-list,
#   each strategy decides for itself.
# AUTH_STRATEGIES="password,google"

# Optional: enable realtime collaboration (run `npm run collab` first).
# NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"

# Optional: AI provider (OpenAI-compatible) for the Ask AI block, AI skills and AI autofill.
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# DeepSeek works with the same shape:
# AI_API_KEY="sk-…"
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-flash"
# An OpenCode Go subscription too (the key comes from opencode.ai/console):
# AI_API_KEY="go-…"
# AI_BASE_URL="https://opencode.ai/inference/go/openai/v1"
# AI_MODEL="glm-5.3-flash"

# Optional: speech-to-text (transcription). Kept separate from the chat provider
# because not every provider offers audio (e.g. DeepSeek does not).
# AI_TRANSCRIBE_API_KEY=""
# AI_TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
# AI_TRANSCRIBE_MODEL="whisper-1"

# Optional: single sign-on (OIDC). Point at your provider's issuer.
# SSO_ISSUER="https://accounts.example.com"
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"
#
# Optional: single sign-on (SAML 2.0, env-level connection). Give the IdP the
# SP metadata URL: https://<your-host>/api/auth/saml/metadata
# AUTH_SAML_SSO_URL="https://idp.example.com/app/noema/sso/saml"
# AUTH_SAML_ENTITY_ID="https://idp.example.com/metadata"
# IdP signing certificate/public key (PEM; \n escapes are accepted).
# AUTH_SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Optional overrides for a reverse proxy whose public URL differs from the
# request origin. Defaults: <origin>/api/auth/saml/metadata and .../acs.
# AUTH_SAML_SP_ENTITY_ID="https://app.example.com/api/auth/saml/metadata"
# AUTH_SAML_CALLBACK_URL="https://app.example.com/api/auth/saml/acs"
# Attribute names. The email default is Azure AD's claim URI; Okta/Google often
# use "email" and "name" (set them explicitly when they do).
# AUTH_SAML_EMAIL_ATTRIBUTE="email"
# AUTH_SAML_NAME_ATTRIBUTE="name"
# AUTH_SAML_GROUPS_ATTRIBUTE="groups"
# Optional SP signing (AuthnRequests + metadata) and assertion decryption.
# AUTH_SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_SAML_SP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AUTH_SAML_DECRYPTION_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_SAML_DECRYPTION_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AUTH_SAML_LOGOUT_URL="https://idp.example.com/app/noema/slo/saml"

# Optional: SMTP for invitations (workspace settings → Email overrides this).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noema@example.com"
# SMTP_FROM_NAME="Noema"
# SMTP_REPLY_TO=""
# SMTP_ALLOW_SELF_SIGNED="false"

# Optional: absolute URL used in invitation emails (otherwise the local dev
# origin — set it for any deployment that serves the public internet).
# APP_URL="https://noema.example.com"

# Optional: public origin(s) the browser uses, for Server Actions behind a
# reverse proxy or tunnel. Comma-separated host[:port] values; the container
# image recomputes its origin allowlist from this at run time.
# APP_ORIGINS="https://noema.example.com"

# Optional: number of trusted reverse-proxy hops in front of the app. 0/empty
# ignores X-Forwarded-For and X-Real-IP entirely. The Edge middleware copy is
# frozen at BUILD time, so `docker compose` also passes this as a build arg.
# TRUSTED_PROXY_HOPS="1"

# Optional: shared secret required by POST /api/cron/templates.
# CRON_SECRET=""

# --- Added by later wiring work (documented here, all optional) -------------
# Admin/private IP allowlist (fix12). Unset = no restriction. When set, the
# private surfaces (/w/<slug>/settings, /w/<slug>/audit, /admin/*) deny any
# client whose forwarded IP does not match; fails CLOSED if malformed.
# Comma-separated CIDRs or IPs, e.g. ADMIN_IP_ALLOWLIST=10.0.0.0/8,127.0.0.1
ADMIN_IP_ALLOWLIST=""
PRIVATE_IP_ALLOWLIST=""
# Number of reverse-proxy hops in front of the app whose forwarding headers
# (X-Forwarded-For / X-Real-IP) may be trusted. Unset or 0 = trust NONE of
# them: those headers are written by the client, so they are ignored for the
# rate-limit buckets and for the IP allowlist above. With N > 0 the
# Nth-from-last X-Forwarded-For hop is used (N=1 = the hop the closest
# trusted proxy appended). The proxy MUST overwrite X-Forwarded-For and
# X-Real-IP — otherwise the values stay client-controlled. Set this to the
# number of proxies between the internet and the app (e.g. 1 for a single
# nginx/Caddy in front of the container).
# NOTE: the IP allowlist is enforced in src/middleware.ts, which runs in the
# Edge runtime — there process.env is frozen at BUILD time, so this variable
# has to be present when the app is built, not only when it is started.
TRUSTED_PROXY_HOPS=""
# Optional: `Strict-Transport-Security` (HSTS). The header is SENT by
# default, with `max-age=31536000` (one year) - a deployment that is served
# over HTTPS pins HTTPS, and a deployment that is not loses nothing, because
# a browser ignores an STS header that arrives over plain HTTP (RFC 6797
# section 7.2). HSTS_MAX_AGE sets the max-age in SECONDS (1..63072000);
# HSTS_MAX_AGE=0 is the documented way out: no header at all, for an
# installation that is deliberately served over plain HTTP. A value that
# cannot be parsed sends no header (fail closed).
# HSTS_INCLUDE_SUBDOMAINS=1 additionally binds every subdomain of the host
# to HTTPS - off by default, because it breaks a sibling that is still
# HTTP-only.
# NOTE: the header list is written into the BUILD (Next reads `headers()`
# from `routes-manifest.json`), so these variables have to be present when
# the app is built - not only when it is started.
HSTS_MAX_AGE=""
HSTS_INCLUDE_SUBDOMAINS=""
# AI token budget per process (fix16). Unset/0 disables the budget gate.
AI_BUDGET_TOKENS=""
# Readiness endpoint secret (fix20); falls back to CRON_SECRET.
READY_SECRET=""
# Asset uploads: local filesystem by default. Set S3_BUCKET to store uploads in
# any S3-compatible endpoint (AWS, MinIO, R2, Garage); reads stay authorised
# through /api/files/<workspace>/<name>.
STORAGE_DIR="./uploads"
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX=""
# Offsite backup destination (optional, independent from the asset bucket).
# When BACKUP_S3_BUCKET is set, `npm run backup` uploads the sealed dump and its
# manifest, reads both back to verify them, and applies the same newest-N
# retention remotely. Leave blank for local-only backups. A bucket without the
# access keys fails closed instead of silently taking a local-only backup.
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_PREFIX="backups"
# Background-job / backup retention cron (fix14). `npm run backup` writes here;
# /api/cron/backups applies the GFS policy below to the files in this directory.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="4"
BACKUP_RETENTION_MONTHLY="12"
BACKUP_RETENTION_YEARLY="3"
# Passphrase that seals the database dump (npm run backup). The dump holds
# every password hash, 2FA seed, OAuth client secret and provider key in
# cleartext, so it is written encrypted (AES-256-GCM) and with mode 0600.
# Unset or shorter than 16 characters: `npm run backup` fails closed and
# writes NO dump at all - it never falls back to an unencrypted one.
# The same value opens the dump again (scripts/backup-restore.mjs).
BACKUP_ENCRYPTION_KEY=""
# Workspace plan tier (fix16/wire16): free | personal | team | enterprise.
WORKSPACE_PLAN="free"
# Outbound webhook targets on the loopback range (127.0.0.0/8, ::1,
# localhost). Unset/0 = the guard refuses them - the production default.
# Set to 1 only when the receiver really runs on this machine; it opens the
# loopback range ONLY, never RFC1918, link-local or cloud-metadata addresses.
NOEMA_ALLOW_LOOPBACK_TARGETS=""
# Hosts the server may fetch a picture from (B69). Pictures that live on
# another host are fetched by the SERVER (the visitor's browser never
# contacts the host, so the host learns neither the visitor's IP address nor
# which Noema instance the visitor came from). Only the hosts on this list are
# fetched; every other host is refused, and a refused host is a broken
# picture. Comma/space separated hostnames. Unset = the default list only (the
# image CDN the app trusts for cover photos: images.unsplash.com,
# plus.unsplash.com). Add a host here to have its pictures shown.
EXTERNAL_IMAGE_ALLOWLIST=""
