# Noema — local development environment
# Copy to `.env` and adjust. `.env` is git-ignored.

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://noema:noema@localhost:5433/noema?schema=public"

# Secret used to sign session cookies (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"

# Optional: sign-in strategy switches (registry: src/lib/auth-strategies.ts).
# AUTH_PASSWORD — the local email + password sign-in and sign-up. Set it to a
#   falsy value ("disabled", "off", "no", "0", "false") to turn the strategy
#   off, e.g. for a single-sign-on-only deployment. Unset = the password
#   strategy is on.
# AUTH_PASSWORD="disabled"
# AUTH_STRATEGIES — comma-separated allow-list of the strategies that may be
#   used, e.g. "password,google,saml". When set, every strategy outside the
#   list is off — including the password sign-in. Unset/blank = no allow-list,
#   each strategy decides for itself.
# AUTH_STRATEGIES="password,google"

# Optional: enable realtime collaboration (run `npm run collab` first).
# NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"

# Optional: AI provider (OpenAI-compatible) for the Ask AI block, AI skills and AI autofill.
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# DeepSeek works with the same shape:
# AI_API_KEY="sk-…"
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-flash"

# Optional: speech-to-text (transcription). Kept separate from the chat provider
# because not every provider offers audio (e.g. DeepSeek does not).
# AI_TRANSCRIBE_API_KEY=""
# AI_TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
# AI_TRANSCRIBE_MODEL="whisper-1"

# Optional: single sign-on (OIDC). Point at your provider's issuer.
# SSO_ISSUER="https://accounts.example.com"
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"

# Optional: SMTP for invitations (workspace settings → Email overrides this).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noema@example.com"
# SMTP_FROM_NAME="Noema"
# SMTP_REPLY_TO=""
# SMTP_ALLOW_SELF_SIGNED="false"

# Optional: absolute URL used in invitation emails (otherwise the request host).
# APP_URL="https://noema.example.com"

# Optional: public origin(s) the browser uses, for Server Actions behind a
# reverse proxy or tunnel. Comma-separated host[:port] values; the container
# image recomputes its origin allowlist from this at run time.
# APP_ORIGINS="https://noema.example.com"

# Optional: shared secret required by POST /api/cron/templates.
# CRON_SECRET=""

# --- Added by later wiring work (documented here, all optional) -------------
# Admin/private IP allowlist (fix12). Unset = no restriction. When set, the
# private surfaces (/w/<slug>/settings, /w/<slug>/audit, /admin/*) deny any
# client whose forwarded IP does not match; fails CLOSED if malformed.
# Comma-separated CIDRs or IPs, e.g. ADMIN_IP_ALLOWLIST=10.0.0.0/8,127.0.0.1
ADMIN_IP_ALLOWLIST=""
PRIVATE_IP_ALLOWLIST=""
# AI token budget per process (fix16). Unset/0 disables the budget gate.
AI_BUDGET_TOKENS=""
# Readiness endpoint secret (fix20); falls back to CRON_SECRET.
READY_SECRET=""
# Background-job / backup retention cron (fix14).
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="4"
BACKUP_RETENTION_MONTHLY="12"
BACKUP_RETENTION_YEARLY="3"
# Workspace plan tier (fix16/wire16): free | personal | team | enterprise.
WORKSPACE_PLAN="free"
# Outbound webhook targets on the loopback range (127.0.0.0/8, ::1,
# localhost). Unset/0 = the guard refuses them - the production default.
# Set to 1 only when the receiver really runs on this machine; it opens the
# loopback range ONLY, never RFC1918, link-local or cloud-metadata addresses.
NOEMA_ALLOW_LOOPBACK_TARGETS=""
