{
  "name": "noema",
  "version": "1.4.1",
  "private": true,
  "description": "An original, open-source, self-hosted workspace for notes, docs and databases — and an installable desktop app that needs nothing else installed.",
  "license": "MIT",
  "author": "Bilel Guembri and Wissal Ben Othmen",
  "contributors": [
    {
      "name": "Bilel Guembri"
    },
    {
      "name": "Wissal Ben Othmen"
    }
  ],
  "homepage": "https://github.com/Guembri01/noema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guembri01/noema.git"
  },
  "bugs": {
    "url": "https://github.com/Guembri01/noema/issues"
  },
  "keywords": [
    "notion-alternative",
    "notes",
    "docs",
    "wiki",
    "database",
    "knowledge-base",
    "self-hosted",
    "local-first",
    "nextjs",
    "react",
    "prisma",
    "postgresql",
    "tauri",
    "open-source"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:bail": "vitest run --bail=1",
    "check:fast": "tsc --noEmit && eslint --quiet . && vitest run --changed --passWithNoTests",
    "e2e:bail": "playwright test --max-failures=1",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "check:a11y": "node --env-file=.env scripts/check-a11y.mjs",
    "check:sso": "node --env-file=.env scripts/check-sso-teamspaces.mjs",
    "check:matrix": "node scripts/feature-matrix-counts.mjs",
    "check:ui": "node --env-file=.env scripts/check-workspace-ui.mjs",
    "check:ai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-ai.mjs",
    "check:routes": "node --env-file=.env scripts/check-routes.mjs",
    "check:mail": "node --env-file=.env scripts/check-mail.mjs",
    "check:providers": "node --env-file=.env scripts/check-ai-providers.mjs",
    "check:tickets": "node --env-file=.env scripts/check-tickets.mjs",
    "docs:gaps": "node scripts/feature-gaps.mjs --write",
    "docs:counts": "node scripts/feature-matrix-counts.mjs --write",
    "audit": "node scripts/audit-inventory.mjs",
    "check:coherence": "node scripts/check-coherence.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:workflow-permissions": "node scripts/check-workflow-permissions.mjs",
    "check:use-server": "node scripts/check-use-server.mjs",
    "check:parent-scope": "node scripts/check-parent-scope.mjs",
    "check:design": "node scripts/check-design-system.mjs --check",
    "design:report": "node scripts/check-design-system.mjs",
    "check:motion": "node scripts/check-motion.mjs --check",
    "motion:report": "node scripts/check-motion.mjs",
    "check:client": "node scripts/check-client-bundle.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:update": "node scripts/visual-check.mjs --update",
    "screenshots": "node --env-file=.env scripts/screenshots.mjs",
    "features:pdf": "node scripts/features-pdf.mjs",
    "desktop:preflight": "node scripts/desktop/preflight.mjs",
    "check:embedded-db": "node scripts/check-embedded-db.mjs",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:smoke": "tsx scripts/desktop/smoke.mjs",
    "desktop:smoke:fresh": "tsx scripts/desktop/smoke.mjs --managed --fresh",
    "desktop:db": "node scripts/desktop/docker-db.cjs --status",
    "desktop:db:ensure": "node scripts/desktop/docker-db.cjs --ensure",
    "desktop:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/capture-window.ps1",
    "desktop:icons": "node scripts/desktop/make-icon.mjs && cargo tauri icon assets/icon.png",
    "desktop:dev": "cargo tauri dev",
    "desktop:dev:web": "next dev --turbopack --port 3200",
    "desktop:build": "cargo tauri build",
    "desktop:bundle": "cargo tauri build --bundles nsis,msi",
    "desktop:info": "cargo tauri info",
    "site:build": "next build",
    "site:start": "next start",
    "site:docker": "docker compose up --build",
    "check:storage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-storage.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "check:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-search.mjs",
    "setup:search": "node --env-file=.env scripts/setup-search.mjs",
    "check:chat-stream": "node --env-file=.env scripts/check-chat-stream.mjs",
    "seed:tickets": "tsx --env-file=.env scripts/seed-demo-tickets.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "backfill:2fa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-2fa-secrets.mjs",
    "collab": "node scripts/collab-server.mjs",
    "postinstall": "prisma generate",
    "check:popovers": "node scripts/check-popovers.mjs",
    "check:floating": "node scripts/check-floating.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:chat": "node scripts/check-chat-live.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "desktop:smoke:embedded": "tsx scripts/desktop/smoke.mjs --embedded",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "check:features": "node scripts/check-payload-features.mjs",
    "audit:motion-spec": "node scripts/audit-motion-spec.mjs",
    "check:animation": "node scripts/check-animation.mjs",
    "check:dates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-commit-dates.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "postcss": "^8.5.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-collaboration-caret": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-drag-handle-react": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
