{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noema",
  "version": "1.4.2",
  "identifier": "app.noema.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev:web",
    "beforeBuildCommand": "npm run desktop:prepare",
    "devUrl": "http://localhost:3200",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Noema",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; media-src 'none'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      },
      "capabilities": ["default", "desktop-remote"]
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Noema"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Noema",
    "homepage": "https://github.com/Guembri01/noema",
    "copyright": "© 2026 Bilel Guembri, Wissal Ben Othmen",
    "category": "Productivity",
    "shortDescription": "Local-first workspace for notes, docs and databases",
    "longDescription": "Noema runs on your machine: notes, databases, projects and AI, with no account required and no data leaving your computer unless you ask it to.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["server/"],
    "externalBin": ["binaries/noema-node"],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Noema",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {}
}
