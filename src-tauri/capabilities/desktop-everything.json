{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-everything",
  "description": "Broad, explicit permissions for the installed app: read/write the user's files, open any URL/path in the OS, pick files, and run its own bundled server. Deliberately permissive per product decision — the app is local-first with a single user. A hardened build drops this capability and keeps only `default`. The served web app is also granted the shell commands that shape its own window and read its own diagnostics; the server lifecycle (`restart_server`, `stop_server`, `set_database_url`, `quit`) and the preference store (`get_pref`, `set_pref`, which holds the unredacted connection string) stay with the shell's own page.",
  "local": true,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-check-update",
    "allow-desktop-info",
    "allow-log-file-path",
    "allow-open-data-dir",
    "allow-open-data-subdir",
    "allow-recent-logs",
    "allow-set-decorations",
    "allow-set-theme",
    "allow-set-window-title",
    "allow-set-zoom",

    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-internal-toggle-maximize",
    "core:event:default",
    "core:path:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:app:allow-set-app-theme",
    "store:default",
    "log:default",
    "window-state:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/noema-node", "sidecar": true, "args": true }]
    },

    "opener:allow-open-url",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",

    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",
    "os:allow-locale",
    "os:allow-hostname",
    "os:allow-os-type"
  ]
}
