{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-everything",
  "description": "Broad, explicit permissions for the installed app: the shell may read/write the user's data directory, open any URL/path in the OS, show notifications, access the clipboard, and run its own sidecar. Deliberately permissive per product decision — the app is local-first and has one user. A hardened deployment can drop this capability and keep only `default`.",
  "local": false,
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/noema-server", "sidecar": true }]
    },

    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://*/*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "https://*" }
      ]
    },

    "opener:allow-open-url",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "mailto:*" }, { "url": "http://127.0.0.1:*" }]
    },

    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",

    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",
    "os:allow-locale",
    "os:allow-hostname",
    "os:allow-os-type",
    "store:default",
    "log:default",
    "window-state:default"
  ]
}
