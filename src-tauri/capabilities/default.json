{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions the shell needs to boot the app: its own window, the local server, dialogs for file picking, logging — and `default`, the app's own permission set (every command in `src/commands.rs`), which is what the shell's first-run/diagnostics page (`dist/index.html`) calls. Declaring the app manifest in `build.rs` switched the ACL on for local origins too, so this replaced their former implicit access.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "default",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-internal-toggle-maximize",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:app:allow-app-hide",
    "core:app:allow-app-show",
    "core:app:allow-set-app-theme",
    "core:event:default",
    "core:path:default",
    "core:menu:default",
    "core:tray:default",
    "core:resources:default",
    "core:image:default",
    "os:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "fs:default",
    "store:default",
    "log:default",
    "window-state:default"
  ]
}
